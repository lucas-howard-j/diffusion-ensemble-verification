figures/**
!figures/main/
!figures/main/**

# Generated L96 sweep plots (sweep data .npz files are included)
lorenz96/sweep/*.pdf
lorenz96/sweep/*.png
lorenz96/figures/

# L63 generated figures
lorenz63/figures/
